{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/__clerk/:path*", "destination": "/__clerk/:path*" },
    { "source": "/((?!assets/|__clerk/|.*\\.).*)", "destination": "/index.html" }
  ]
}
