# Mission Identité — configuration frontend (exemple sans secrets)
# Mode dev  : VITE_AUTH_MODE=dev  → auth simulée backend
# Mode clerk: VITE_AUTH_MODE=clerk + clé PUBLIQUE Clerk ci-dessous
# JAMAIS CLERK_SECRET_KEY ici — le frontend n'utilise que la clé
# publique ( publishable ), qui est public par conception.
VITE_AUTH_MODE=clerk
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_URL=