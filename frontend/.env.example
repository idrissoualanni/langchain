# Mission Identité — configuration frontend (exemple sans secrets)
#
# Auth : Neon Managed Better Auth ( email / mot-de-passe + OAuth ).
# Le SDK officiel n'est pas utilisé — on parle l'API REST Better Auth
# via fetch ( cf. src/lib/neon.ts ). Voir ce fichier pour pourquoi.
#
# VITE_AUTH_MODE=neon  → production ( défaut attendu )
# VITE_AUTH_MODE=dev   → développement local, auth simulée par le
#                        backend. Aucune clé externe requise.
#
# VITE_NEON_AUTH_URL : endpoint public Neon Auth ( PAS un secret ).
# VITE_API_URL       : URL du backend FastAPI.
VITE_AUTH_MODE=neon
VITE_NEON_AUTH_URL=
VITE_API_URL=
