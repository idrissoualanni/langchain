# Langfuse v4 — variables d'environnement (copier vers .env, JAMAIS committé)
# Générer les secrets :  ./generate-secrets.sh > .env   (puis compléter les
# champs vides ci-dessous). Toutes les valeurs ici sont FACTICES.

# ------------------------------------------------------------------
# Postgres (conteneur local)
# ------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_factice_64hex
POSTGRES_DB=postgres

# ------------------------------------------------------------------
# ClickHouse
# ------------------------------------------------------------------
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse_password_factice_64hex

# ------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------
REDIS_AUTH=redis_password_factice_64hex

# ------------------------------------------------------------------
# MinIO (S3)
# ------------------------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_password_factice_64hex

# ------------------------------------------------------------------
# Langfuse — secrets d'application (openssl rand -hex)
# ------------------------------------------------------------------
# URL publique de l'interface (locale ou https://<votre-instance>.onrender.com)
NEXTAUTH_URL=http://localhost:3000
# >= 256 bits (64 hex) — generate-secrets.sh
NEXTAUTH_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# >= 256 bits (64 hex)
SALT=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
# Exactement 64 hex
ENCRYPTION_KEY=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc

# Connexion Postgres utilisée par Langfuse (locale via le réseau compose)
DATABASE_URL=postgresql://postgres:postgres_password_factice_64hex@postgres:5432/postgres

# ------------------------------------------------------------------
# Sécurité : inscription ouverte désactivée
# ------------------------------------------------------------------
AUTH_DISABLE_SIGNUP=true
# Emails autorisés à créer des organisations (virgules). Laisser vide pour
# interdire toute création d'organisation après l'init headless.
LANGFUSE_ALLOWED_ORGANIZATION_CREATORS=

# ------------------------------------------------------------------
# Initialisation automatique (headless) — org + projet + clés + admin
# Créée au premier démarrage du service web si absent. Ne PAS quoter.
# ------------------------------------------------------------------
LANGFUSE_INIT_ORG_ID=agent-tutor
LANGFUSE_INIT_ORG_NAME=Agent Tutor
LANGFUSE_INIT_PROJECT_ID=agent-tutor-prod
LANGFUSE_INIT_PROJECT_NAME=Agent Tutor (prod)
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-valeur_factice_publique
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-valeur_factice_secrete
# Compte admin initial — À REMPLIR avec ton email et un mot de passe fort
# (le mot de passe peut être généré par generate-secrets.sh, édité ici).
LANGFUSE_INIT_USER_EMAIL=admin@exemple.fr
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=dddddddddddddddddddddddddddddddd

# ------------------------------------------------------------------
# Télémétrie (désactivée par défaut dans ce compose)
# ------------------------------------------------------------------
TELEMETRY_ENABLED=false