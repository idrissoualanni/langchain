# ============================================================================
# Caddyfile — EXEMPLE OPTIONNEL (non utilisé avec Render)
# ============================================================================
# Avec Render, le TLS est géré par Render (https://<votre-instance>.onrender.com)
# et CE FICHIER N'EST PAS NÉCESSAIRE.
#
# Ceci n'est utile que si un jour tu déploies ce docker-compose sur un VPS
# avec un domaine : Caddy termine le HTTPS et reverse-proxie vers le service
# langfuse-web (port 3000, non exposé publiquement dans ce cas).
#
# Usage sur VPS :
#   1. Renseigner LANGFUSE_INIT_USER_EMAIL et NEXTAUTH_URL=https://langfuse.<domaine>
#   2. docker compose up -d
#   3. lancer Caddy avec ce fichier (DNS du domaine pointé vers le VPS)
#
# Remplace langfuse.example.com par ton domaine.

langfuse.example.com {
	encode gzip zstd

	# La taille des traces peut être importante ; autoriser les uploads volumineux.
	request_body {
		max_size 50MB
	}

	reverse_proxy langfuse-web:3000

	# Journaux d'accès (rotation gérée par Caddy).
	log {
		output file /var/log/caddy/langfuse.log
	}
}