# Python bytecode and caches
__pycache__/
*.pyc

# Environment variables
.env
.env.local

# Dumps d'API exporters en local (Render / Neon). Contiennent des IDs
# d'infrastructure et des URLs d'orga. Ne se committent jamais.
proj-neon.json
svc_raw.json
backend/authcfg.json
backend/create.json

# Secrets OAuth MCP (Google Calendar)
backend/data/mcp/google/
backend/authcfg.json

# Artefacts LangGraph locaux (checkpoints + store pickles : conversations)
backend/.langgraph_api/

# Base SQLite locale (abandonnée en prod, cf. ADR-002)
backend/database/
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# Sessions agent
.zcode/
.zcodeignore

# Collection API Postman (requêtes + environnements : contient des variables
# locales email/password/jwt — ne se committe jamais)
postman/
# Collections API (client local — lutilisateur les garde hors du dépôt)
postman/
**/postman/

# Artefacts générés par les tests Vitest / Playwright — jamais sur GitHub :
# ce sont des sorties de machine (rapports, traces, captures), pas du code.
frontend/test-results/
frontend/playwright-report/
frontend/coverage/
.playwright-mcp/
vitest-ui.png

.opencode

# Lanceur de tests Windows local (menu Vitest UI / Playwright).
# Utile sur une machine, inutile pour les autres : un raccourci de poste
# n'est pas du code du projet.
lancer-tests.cmd

# Lien local Vercel CLI : contient l'ID du projet et de l'equipe.
# Specifique a une machine et a un compte, jamais commite.
.vercel

# .env.local cree PAR LE CLI VERCEL ( jeton OIDC, ID projet ) — racine
# uniquement. PAS un `.env*` global : frontend/.env.production est
# volontairement TRACKE ( sans lui le build Vercel embarque
# VITE_API_URL vide et tape l'origine Vercel au lieu de l'API ), et
# backend/.env est le secret de la machine. Un motif large les
# rendrait invisibles au lieu de manquants.
/.env.local
.env*
.claude
