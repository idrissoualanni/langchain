# ============================================================
# APPLICATION
# ============================================================

APP_ENV=development
APP_NAME=agent-tutor
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ============================================================
# API
# ============================================================

API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# ============================================================
# AUTH — Clerk (production) / dev (local)
# ============================================================

AUTH_MODE=clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCES=
CLERK_JWT_LEEWAY=60
ADMIN_CLERK_IDS=

# ============================================================
# LANGGRAPH
# ============================================================

LANGGRAPH_CHECKPOINT_DB=./database/checkpoints.db
LANGGRAPH_STORE_DB=./database/long_term_memory.db

# ============================================================
# MODEL GATEWAY
# ============================================================

MODEL_GATEWAY_ENABLED=false
MODEL_GATEWAY_PROVIDER=litellm
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=
LITELLM_MASTER_KEY=

DEFAULT_MODEL_ID=default
CODING_MODEL_ID=coding
RESEARCH_MODEL_ID=research
FAST_MODEL_ID=fast
REASONING_MODEL_ID=reasoning
VISION_MODEL_ID=vision

# ============================================================
# PROVIDERS
# ============================================================

OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=
MODEL_OLLAMA=gemma4:31b-cloud

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Cloudflare Workers AI — embeddings CLOUD GRATUITS (free tier
# 10 000 neurons/jour ; @cf/baai/bge-m3 = 1075 neurons / M input
# tokens). Provider « cf-workers-ai » dans app/embeddings.yaml.
# AUCUN SECRET ICI : créez le token sur
# https://dash.cloudflare.com/profile/api-tokens (template
# « Workers AI Read » / scope Workers AI Read).
# CLOUDFLARE_ACCOUNT_ID se trouve sur le dashboard Cloudflare
# (accueil du compte, en bas à droite).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Pour activer les embeddings cloud (au choix) :
#   EMBEDDING_PROVIDER=cf-workers-ai
#   (équivalent à « active: cf-workers-ai » dans embeddings.yaml)

# ============================================================
# SEARCH
# ============================================================

TAVILY_API_KEY=

# ============================================================
# LIVEKIT REALTIME (Voice/Video)
# Vide = credentials dev par défaut (devkey/devsecret) avec warning
# ============================================================

LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent tuteur vocal — modèles LiveKit Inference (app/livekit/agent.py)
# Ces valeurs sont les valeurs par défaut de app/config.py : non-secrets,
# juste des identifiants de modèles publics. Décommenter pour surcharger.
# LIVEKIT_AGENT_LANGUAGE=fr
# LIVEKIT_AGENT_STT_MODEL=deepgram/nova-3
# LIVEKIT_AGENT_LLM_MODEL=google/gemma-4-31b-it
# LIVEKIT_AGENT_TTS_MODEL=rime/coda
# LIVEKIT_AGENT_TTS_VOICE=aurelie

# ============================================================
# LANGSMITH OBSERVABILITY
# ============================================================

LANGSMITH_ENABLED=true
LANGSMITH_API_KEY=
# LangSmith n'utilise pas de secret key séparé (seulement API_KEY)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=agent-tutor
LANGSMITH_ENVIRONMENT=development

# ============================================================
# KNOWLEDGE ACCESS CONTROL
# ============================================================

KNOWLEDGE_ACCESS_ENABLED=true
KNOWLEDGE_DEFAULT_SCOPE=private

# ============================================================
# RAG / DOCUMENTS
# ============================================================

RAG_ENABLED=true
EMBEDDING_PROVIDER=ollama
DOCUMENT_STORE_DB=./database/user_documents.db

# ============================================================
# MEMORY
# ============================================================

MEMORY_ENABLED=true
MEMORY_STORE_DB=./database/long_term_memory.db

# ============================================================
# LEARNING
# ============================================================

LEARNING_ENGINE_ENABLED=true

# ============================================================
# AGENT
# ============================================================

AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOOL_CALLS=20
AGENT_TIMEOUT_SECONDS=120

# ============================================================
# STREAMING
# ============================================================

SSE_ENABLED=true

# ============================================================
# OBSERVABILITY
# ============================================================

OBSERVABILITY_ENABLED=true
OTEL_ENABLED=true
OTEL_SERVICE_NAME=agent-tutor